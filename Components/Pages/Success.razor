@page "/success"
@rendermode InteractiveServer

@using Microsoft.EntityFrameworkCore
@using SkyTicket.Data.Models

@inject SkyTicketContext Db
@inject NavigationManager Navigation

<PageTitle>Бронирование завершено — SkyTicket</PageTitle>

<div class="success-page">

    <div class="success-card">

        <div class="success-icon">
            ✓
        </div>

        <h1>Бронирование успешно завершено!</h1>

        <p class="success-text">
            Ваш билет успешно забронирован и оплачен.
        </p>


        @if (booking == null)
        {
            <p>Загрузка информации о бронировании...</p>
        }
        else
        {
            <div class="booking-number">

                Номер бронирования:

                <strong>
                    #@booking.Id
                </strong>

            </div>


            <div class="success-info">

                <p>
                    <strong>Рейс:</strong>
                    @booking.Flight.FlightNumber
                </p>

                <p>
                    <strong>Маршрут:</strong>
                    @booking.Flight.DepartureAirport.City
                    →
                    @booking.Flight.ArrivalAirport.City
                </p>

                <p>
                    <strong>Дата:</strong>
                    @booking.Flight.DepartureTime.ToString("dd.MM.yyyy")
                </p>

                <p>
                    <strong>Время:</strong>
                    @booking.Flight.DepartureTime.ToString("HH:mm")
                </p>

                <p>
                    <strong>Место:</strong>
                    @booking.SeatNumber
                </p>

                <p>
                    <strong>Статус:</strong>

                    <span class="paid">
                        Оплачено
                    </span>
                </p>

            </div>


            <button type="button"
                    class="home-button"
                    @onclick="GoHome">

                Вернуться на главную

            </button>
        }

    </div>

</div>


@code {

    [SupplyParameterFromQuery(Name = "bookingId")]
    private int? BookingId { get; set; }


    private SkyTicket.Data.Models.Booking? booking;


    protected override async Task OnInitializedAsync()
    {
        if (BookingId.HasValue)
        {
            booking = await Db.Bookings
                .Include(b => b.Flight)
                    .ThenInclude(f => f.DepartureAirport)
                .Include(b => b.Flight)
                    .ThenInclude(f => f.ArrivalAirport)
                .FirstOrDefaultAsync(
                    b => b.Id == BookingId.Value);
        }
    }


    private void GoHome()
    {
        Navigation.NavigateTo("/");
    }

}